{
  "name": "visualizer",
  "productName": "Visualizer",
  "version": "1.0.0",
  "description": "Visualizer: wideo z filtrami sterowanymi dźwiękiem z systemu",
  "main": "./out/main/index.js",
  "author": "Shaggy",
  "homepage": "https://example.com/visualizer",
  "desktopName": "visualizer.desktop",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:panel": "tsc --noEmit -p tsconfig.panel.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:panel",
    "dev": "concurrently -k -n front,panel -c magenta,cyan \"electron-vite dev\" \"npm run dev:panel\"",
    "dev:front": "electron-vite dev",
    "dev:panel": "vite --config vite.panel.config.mts",
    "start": "electron-vite preview",
    "build:panel": "vite build --config vite.panel.config.mts",
    "build": "npm run typecheck && electron-vite build && npm run build:panel",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:linux": "npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@xyflow/react": "^12.12.1",
    "concurrently": "^10.0.7",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "^21.0.4",
    "postprocessing": "^6.39.6",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
